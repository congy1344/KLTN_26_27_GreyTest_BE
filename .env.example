# Copy to .env and fill real values. Do not commit .env.
# LLM_PROVIDER: mock | openai | google
# VietAPI uses an OpenAI-compatible Chat Completions API:
# LLM_PROVIDER=openai
# LLM_MODEL=claude-sonnet-4-6
# LLM_OPENAI_URL=https://api.mwapi.dev/v1/chat/completions
LLM_PROVIDER=mock
LLM_API_KEY=your-api-key-here
LLM_API_KEY1=
LLM_API_KEY2=
LLM_API_KEY3=
LLM_API_KEY4=
LLM_API_KEY5=
LLM_API_KEY6=
LLM_API_KEY7=

# OpenAI: gpt-4o-mini
# VietAPI: deepseek-v4-flash (hoac gpt-5.5)
# Google: gemini-3.5-flash
LLM_MODEL=gpt-4o-mini

# Tối ưu Claude: tối đa 2 batch đồng thời, output ngắn theo từng công đoạn.
GREYTEST_LLM_BATCH_CONCURRENCY=2
LLM_MAX_TOKENS_BUSINESS_RULE=4096
LLM_MAX_TOKENS_BUSINESS_RULE_REVIEW=4096
LLM_MAX_TOKENS_TEST_PLAN=6144
LLM_MAX_TOKENS_TEST_CASE=8192
LLM_MAX_TOKENS_UNIT_TEST=12288
LLM_MAX_TOKENS_COVERAGE_REFINEMENT=6144

# Dev-only token metrics. Moi model/lan lap nen dung mot RUN_ID rieng.
LLM_USAGE_ENABLED=false
LLM_USAGE_OUTPUT_DIR=../log/llm-usage
LLM_USAGE_RUN_ID=
LLM_USAGE_METHOD=GREYTEST


# Debug AI context/prompt local. Khong bat mac dinh vi co the chua source code.
GREYTEST_AI_CONTEXT_LOG_ENABLED=false
GREYTEST_AI_CONTEXT_LOG_CONSOLE_ENABLED=false
GREYTEST_AI_CONTEXT_LOG_PATH=../log

# Bat buoc, toi thieu 32 ky tu. Vi du: openssl rand -base64 32
GREYTEST_AUTH_TOKEN_SECRET=change-me-with-at-least-32-characters

# Quota mac dinh cho moi user, reset theo thang. Admin co the sua rieng tren dashboard.
GREYTEST_DEFAULT_MONTHLY_LLM_QUOTA=100
