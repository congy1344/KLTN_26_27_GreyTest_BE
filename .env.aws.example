# Copy ngoài repo: /opt/greytest/config/.env; chmod 600; không commit file thật.
# docker compose --env-file /opt/greytest/config/.env -f docker-compose.aws.yml ...
RELEASE_TAG=replace-with-release-id
SITE_ADDRESS=replace-with-your-subdomain.duckdns.org
POSTGRES_PASSWORD=
GREYTEST_AUTH_TOKEN_SECRET=

# Khởi động mock trước; key của provider thật không thuộc AWS credit.
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_API_KEY1=
LLM_API_KEY2=
LLM_API_KEY3=
LLM_API_KEY4=
LLM_API_KEY5=
LLM_API_KEY6=
LLM_API_KEY7=
LLM_MODEL=gpt-4o-mini
LLM_OPENAI_URL=https://api.vietapi.tech/v1/chat/completions
LLM_GOOGLE_URL=https://generativelanguage.googleapis.com/v1beta/interactions
LLM_TIMEOUT_SECONDS=300
GREYTEST_LLM_BATCH_CONCURRENCY=1
GREYTEST_LLM_CACHE_MAX_ENTRIES=100
GREYTEST_DEFAULT_MONTHLY_LLM_QUOTA=100
GREYTEST_PLUS_WEEKLY_LLM_QUOTA=200
GREYTEST_PRO_MONTHLY_LLM_QUOTA=300

# Thử local: SITE_ADDRESS=:80 và bỏ comment ba dòng sau, chỉ bind loopback.
# WEB_BIND_ADDRESS=127.0.0.1
# WEB_HTTP_PORT=18080
# WEB_HTTPS_PORT=18443

# Chỉ chỉnh sau khi đo RAM: container backend có giới hạn 1152 MiB.
JAVA_TOOL_OPTIONS=-Xms128m -Xmx768m -XX:+ExitOnOutOfMemoryError
